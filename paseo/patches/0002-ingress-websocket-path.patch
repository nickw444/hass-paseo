+++ b/packages/app/src/utils/daemon-endpoints.ingress.test.ts
@@ -0,0 +1,34 @@
+import { afterEach, describe, expect, test, vi } from "vitest";
+import { buildDaemonWebSocketUrl } from "./daemon-endpoints";
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+describe("ingress WebSocket path", () => {
+  test("keeps the root path for non-browser runtimes", () => {
+    expect(buildDaemonWebSocketUrl("ha.local:8123", { useTls: false })).toBe(
+      "ws://ha.local:8123/ws",
+    );
+  });
+
+  test("prefixes same-origin sockets once", () => {
+    vi.stubGlobal("window", { location: { host: "ha.local:8123", hostname: "ha.local", port: "8123", protocol: "https:" } });
+    (globalThis as Record<string, unknown>).__PASEO_WEB_BASE_PATH__ = "/api/hassio_ingress/paseo/";
+    expect(buildDaemonWebSocketUrl("ha.local:8123", { useTls: true })).toBe(
+      "wss://ha.local:8123/api/hassio_ingress/paseo/ws",
+    );
+  });
+
+  test("ignores invalid prefixes and remote sockets", () => {
+    vi.stubGlobal("window", { location: { host: "ha.local:8123", hostname: "ha.local", port: "8123", protocol: "http:" } });
+    (globalThis as Record<string, unknown>).__PASEO_WEB_BASE_PATH__ = "javascript:alert(1)";
+    expect(buildDaemonWebSocketUrl("ha.local:8123", { useTls: false })).toBe(
+      "ws://ha.local:8123/ws",
+    );
+    (globalThis as Record<string, unknown>).__PASEO_WEB_BASE_PATH__ = "/prefix";
+    expect(buildDaemonWebSocketUrl("remote.local:6767", { useTls: false })).toBe(
+      "ws://remote.local:6767/ws",
+    );
+  });
+});
