+function getIngressBasePath(): string {
+  if (typeof window === "undefined") return "";
+  const value = (globalThis as Record<string, unknown>).__PASEO_WEB_BASE_PATH__;
+  if (typeof value !== "string" || value === "") return "";
+  const trimmed = value.trim();
+  if (!trimmed.startsWith("/") || trimmed === "/") return "";
+  return `/${trimmed.replace(/^\/+|\/+$/g, "")}`;
+}
+
+export function buildDaemonWebSocketUrl(endpoint: string, opts: { useTls: boolean }): string {
+  const url = new URL(buildSharedDaemonWebSocketUrl(endpoint, opts));
+  if (typeof window === "undefined") {
+    return url.toString();
+  }
+  const browserPort = window.location.port || (window.location.protocol === "https:" ? "443" : "80");
+  const socketPort = url.port || (url.protocol === "wss:" ? "443" : "80");
+  if (url.hostname !== window.location.hostname || socketPort !== browserPort) {
+    return url.toString();
+  }
+  const base = getIngressBasePath();
+  if (!base || url.pathname === `${base}/ws` || url.pathname.startsWith(`${base}/ws/`)) {
+    return url.toString();
+  }
+  url.pathname = `${base}${url.pathname}`.replace(/\/+/g, "/");
+  return url.toString();
+}
